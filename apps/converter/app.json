{
  "manifest": 1,
  "id": "converter",
  "name": "Convert Old Files",
  "description": "Drop Publisher, WordPerfect, Works, Lotus 1-2-3, ClarisWorks and Access files and get modern files back. The files stay on this computer.",
  "version": "0.2.0",
  "icon": "public/icon.svg",
  "window": { "width": 620, "height": 640, "minWidth": 320, "minHeight": 320 },
  "entry": "public",
  "toolchains": ["rescue"],
  "files": ["~/Converted/"],
  "access": {
    "fs": ["~/Converted"],
    "network": false,
    "commands": ["wpd2html", "pub2xhtml", "wps2html", "wks2csv", "wdb2csv", "mwaw2html", "mwaw2csv", "mdb-tables", "mdb-export", "mdb-schema", "pandoc", "soffice"]
  }
}
