# Environment for server.mjs on tabcomputer.com (systemd EnvironmentFile; the
# tabcomputer profile, docs/PROFILES.md).
# Shipped with every release; no secrets here, this repo is public.
# TABCOMPUTER_* names.

# Raw TCP relay at /tcp for guest sockets (docs/NETWORKING.md). Open for now;
# set TABCOMPUTER_TCP_REQUIRE_SIGNIN=1 to require a GitHub sign-in (docs/DESKTOP.md).
TABCOMPUTER_TCP_RELAY=1
TABCOMPUTER_TCP_ORIGINS=https://tabcomputer.com,https://*.tabcomputer.com
TABCOMPUTER_TCP_REQUIRE_SIGNIN=0
# Tokens not tied to the fetching IP: proxy pools, iCloud Private Relay and
# dual-stack clients change IP between the token fetch and each connection.
TABCOMPUTER_TCP_TOKEN_BIND_IP=0
# Guests (docs/research/GUEST_PROFILE.md): guest--<name>.tabcomputer.com, a clean
# tabcomputer on its own origin for untrusted work.
TABCOMPUTER_GUESTS=1
# Shared seeds (`seed share`, /s/<id>): off. TABCOMPUTER_SEED_SHARE=1 would make
# this server store what people upload (docs/DATA_FLOW.md); not set on purpose.
# Toolchain layers (`toolchain install`), built in the background by
# release.sh into this directory (docs/DEBIAN.md "Toolchain layers")
TABCOMPUTER_DEBIAN_LAYERS=/opt/tabcomputer/layers
# Package layers (docs/DEBIAN.md "Package layers"): a layer for any set of
# Debian packages (`apt install`, an app's `needs`), built here the first
# time a tab asks and kept in /opt/tabcomputer/layers/sets. One build at a
# time, at idle priority with half a CPU, 900 MB of memory and 15 minutes at
# most, in a mount namespace of its own (server.mjs packageBuildCommand).
# 0 or unset: no builds on request; the sets release.sh builds at deploy
# (src/debian/package-sets.json) are still served, and tabs use apt for the rest.
# On since Build 1021: the builder was seen to work on the droplet in Build 1019
# (the tesseract-ocr set, applied on production in 0.2 s).
TABCOMPUTER_LAYER_BUILDER=1
# Chunks of all package sets on disk, MB. A typical set is 40 MB
# (tesseract-ocr: 71 packages). Past this the sets used longest ago go first.
TABCOMPUTER_LAYER_SETS_MAX_MB=3072
# Pyodide (numpy, pandas, matplotlib for python3) from this site at
# /pyodide/v<VERSION>/full/ instead of cdn.jsdelivr.net (server.mjs "Pyodide
# distribution"): each file is fetched from the upstream once, checked against
# its sha256 and kept here. On by default; 0 makes the route a 404 and the
# page uses jsdelivr.
TABCOMPUTER_PYODIDE=1
# Where the server fetches from: files are at <this>/v<VERSION>/full/<FILE>.
TABCOMPUTER_PYODIDE_UPSTREAM=https://cdn.jsdelivr.net/pyodide
# The copies. The default is $TMPDIR/tabcomputer-pyodide, which a reboot
# empties; this one stays (the server makes the directory). About 30 MB once a
# class has used numpy, pandas and matplotlib; 462 MiB if every package of a
# version is asked for.
TABCOMPUTER_PYODIDE_CACHE=/opt/tabcomputer/pyodide
# Past this many MB on disk a file is served without being kept.
TABCOMPUTER_PYODIDE_CACHE_MAX_MB=1024
# Relay throughput (tabcomputer#51). The defaults (4 MiB/s per IP, 16 MiB
# burst, 512 KiB in flight per connection) capped x86 downloads at about
# 4 MB/s: `claude install` took ~57 s. Per-IP token bucket, shared by all of
# an IP's connections; the 4 GiB/hour per-IP cap still applies.
TABCOMPUTER_TCP_BYTES_PER_SEC=16777216
TABCOMPUTER_TCP_BYTE_BURST=134217728
# Unacked bytes in flight per connection; 512 KiB per ~100 ms RTT was ~5 MB/s.
TABCOMPUTER_TCP_WINDOW=2097152
