From 6af29c938858c22d966a0b35f1a0645bd80e28b4 Mon Sep 17 00:00:00 2001
From: shiro <build@shiro>
Date: Sun, 11 Oct 2026 05:43:14 +0000
Subject: [PATCH] Shiro: fchmodat2(fd, "", mode, AT_EMPTY_PATH) is fchmod(fd)
 again

0514's empty-path check (ENOENT, LTP fchmodat02) also caught fchmodat2
with AT_EMPTY_PATH, which Linux 6.6+ runs as fchmod of the descriptor,
O_PATH ones included. systemd 257's fchmod_opath() calls exactly that and
treats ENOENT as fatal: systemd-sysusers failed in systemd's postinst
("Failed to copy permissions from /etc/group to /etc/.#group..."), and
with it every apt install that pulls in systemd (udev, initramfs-tools,
linux-image-*). The kernel already takes a zero-length path as the fd.
An empty path without AT_EMPTY_PATH is still ENOENT.
---
 blink/shiro.inc | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 2389212..6e0c921 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -716,7 +716,10 @@ static i64 ShiroAtCall(struct Machine *m, int nr, int dirfd, i64 path, int a2,
   int n = ShiroPath(m, path, buf, 0);
   if (n < 0) return n;
   if (nr == 257 && ShiroIsOwnMaps(m, buf, n)) return ShiroMapsFd(m, a2);
-  if (!n && (nr == 268 || nr == 259)) return -ENOENT_LINUX;  // (an empty path: LTP fchmodat02)
+  // An empty path is ENOENT (LTP fchmodat02), except fchmodat2's AT_EMPTY_PATH
+  // (a3 here): that is fchmod of dirfd, O_PATH included, which the kernel does
+  // for a zero-length path (systemd's fchmod_opath, systemd-sysusers in its postinst)
+  if (!n && ((nr == 268 && !(a3 & 0x1000)) || nr == 259)) return -ENOENT_LINUX;
   return ShiroCall(m, nr, A12(dirfd, n, a2, a3), buf, n, 0, true, true);
 }
 
@@ -4652,7 +4655,7 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
     case 0x05B: r = KS(m, 91, A12(a, b)); break;                      // fchmod
     case 0x10C: case 0x1C4:                                           // fchmodat(2)
       // fchmodat2's flags: AT_SYMLINK_NOFOLLOW, AT_EMPTY_PATH (LTP fchmodat02)
-      r = nr == 0x1C4 && (d & ~(0x100 | 0x1000)) ? -EINVAL_LINUX : ShiroAtCall(m, 268, a, b, c, 0);
+      r = nr == 0x1C4 && (d & ~(0x100 | 0x1000)) ? -EINVAL_LINUX : ShiroAtCall(m, 268, a, b, c, nr == 0x1C4 ? (int)(d & 0x1000) : 0);
       break;
     // ownership isn't kept; these check that the file exists, and lchown and
     // AT_SYMLINK_NOFOLLOW look at a symlink itself (dpkg lchowns NAME.dpkg-new
-- 
