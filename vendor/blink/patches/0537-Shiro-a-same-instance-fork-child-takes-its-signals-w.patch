From 50ef4df64a9067c841f14c8bb781649fa7288278 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 10:04:51 +0000
Subject: [PATCH] Shiro: a same-instance fork child takes its signals while its
 parent sits in a kernel call: Blink's waits (pause, sigsuspend, nanosleep)
 ask the kernel each slice of 1 ms or more, and the worker's main thread runs
 its queued calls in direct-channel waits (LTP pause01)

---
 blink/shiro.inc | 19 +++++++++++++++++++
 blink/syscall.c |  4 ++++
 2 files changed, 23 insertions(+)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 805c41a..84d5498 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -192,6 +192,11 @@ static bool ShiroDirectCallAs(int nr, int args[12], int as, void *data, int inle
       } else {
         shiro_dch_wait(1, 10);
       }
+      // The worker's main thread blocked here runs what other threads asked
+      // of it (a new thread's Worker, shiro_hosted), as emscripten's own
+      // futex waits do: a fork child waited for its thread while its parent
+      // sat in a kernel call (LTP pause01)
+      if (emscripten_is_main_runtime_thread()) emscripten_current_thread_process_queued_calls();
     }
   }
   if (shiro_dch_state() == 4) {  // closed while we waited: the process is gone
@@ -2660,6 +2665,20 @@ static void ShiroLockPages(struct Machine *m, i64 start, i64 end, bool on) {
   InvalidateSystem(s, true, false);
 }
 
+// A wait in Blink (pause, sigsuspend, nanosleep's slices) asks the kernel
+// for its signals now and then: a call on the thread's own channel brings
+// one back on the reply. They also come as host.mjs's blink-signal, but that
+// runs on the worker's main thread, which a process busy on direct channels
+// may not let it have: a same-instance fork child slept through kill() while
+// its parent ran (LTP pause01)
+EMSCRIPTEN_KEEPALIVE int blink_shiro_sigpoll(void) { return 1; }
+
+static void ShiroPollSignals(struct Machine *m) {
+  if (g_shiro_pid && !t_vfork && !(m->signals & ~m->sigmask)) KS(m, 39, A12(0));  // getpid
+  // (and the worker's main thread, asleep here, does what other threads asked of it)
+  if (emscripten_is_main_runtime_thread()) emscripten_current_thread_process_queued_calls();
+}
+
 // mincore: a page is resident once it has its memory (not still reserved)
 static i64 ShiroMincore(struct Machine *m, i64 addr, u64 len, i64 vec) {
   u8 *v, *slot;
diff --git a/blink/syscall.c b/blink/syscall.c
index 3f02ac6..05acd59 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -794,10 +794,12 @@ static void ShiroCommitPages(struct Machine *, i64, i64);
 static void ShiroSetComm(struct Machine *, const char *);
 static void ShiroSetSubreaper(struct Machine *, bool);
 static void ShiroLockPages(struct Machine *, i64, i64, bool);
+static void ShiroPollSignals(struct Machine *);
 static i64 ShiroEuid(struct Machine *);
 #else
 #define ShiroSleeping(m, n) (void)0
 #define ShiroSetSubreaper(m, on) (void)0
+#define ShiroPollSignals(m) (void)0
 #define ShiroSyncMask(m) (void)0
 #define ShiroInterruptThread(m) (void)0
 #endif
@@ -4607,6 +4609,7 @@ static int SysNanosleep(struct Machine *m, i64 req, i64 rem) {
     }
     if (sleeping) ts = SubtractTime(ts, FromMilliseconds(3));  // unmark before the end
     if (CompareTime(ts, FromMilliseconds(10)) > 0) ts = FromMilliseconds(10);
+    if (CompareTime(ts, FromMilliseconds(1)) >= 0) ShiroPollSignals(m);
     if ((m->signals & ~m->sigmask) || nanosleep(&ts, 0)) {
 #else
     if (nanosleep(&ts, 0)) {
@@ -4805,6 +4808,7 @@ static int SigsuspendPolyfill(struct Machine *m, u64 mask) {
         sched_yield();
 #endif
       } else {
+        if (nanos >= 1000 * 1000) ShiroPollSignals(m);
         ts = FromNanoseconds(nanos);
         if (nanosleep(&ts, 0)) {
           unassert(errno == EINTR);
-- 
