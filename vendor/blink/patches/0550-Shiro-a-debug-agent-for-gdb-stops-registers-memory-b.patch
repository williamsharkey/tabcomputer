+  // a debugger sees the signal first, and may take it (shirogdb.inc)
+  if (g_shiro_gdb && !ShiroGdbSignal(m)) {
+    if (delivered) *delivered = 0;
+    if (restart) *restart = true;
+    return 0;
+  }
