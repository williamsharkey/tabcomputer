diff --git a/blink/shiro.inc b/blink/shiro.inc
index 0000000..0000000 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -333,7 +333,7 @@ EMSCRIPTEN_KEEPALIVE int blink_shiro_forkrestart(void) { return 1; }
 static i64 ShiroCallIn(struct Machine *m, int nr, const int a[12], void *data,
                        int inlen, int outcap, bool restart, bool intr) {
   int args[12], r, as;
-  bool held;
+  bool held, mid;
   i64 res;
   if (m && nr != 14) ShiroSyncMask(m);
   // The mask just sent can release a signal the kernel held (ppoll and
@@ -348,12 +348,18 @@ static i64 ShiroCallIn(struct Machine *m, int nr, const int a[12], void *data,
   for (;;) {
     memcpy(args, a, sizeof(args));
     held = GilHeld();
+    // outside a system call this is a fault's call, in the middle of an
+    // instruction that may write through an address it has already
+    // (wjit.c, code on writable pages)
+    mid = held && m && !m->insyscall;
+    if (mid) WjMidInstruction(1);
     if (held) GilRelease();
     r = ShiroKsys(nr, args, as, data, inlen, outcap);
     // system time: every call counts as a quick call's time (a clock read
     // on each side of every call cost more than the estimate is off by)
     if (m) __atomic_fetch_add(&m->system->shiro_sysns, SHIRO_CALL_NS, __ATOMIC_RELAXED);
     if (held) GilAcquire();
+    if (mid) WjMidInstruction(-1);
     res = (i64)(u64)(u32)r | (i64)args[0] << 32;
     // (a same-instance fork child calls as itself and takes its own
     // signals, so it restarts as SA_RESTART says; a vfork child runs on its
@@ -4782,6 +4788,7 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
         break;
     }
   }
+  if (nr == 0x0E7) WjExitStats();  // (BLINK_WJIT_DEBUG)
   if (nr == 0x0E7 && g_shiro_pid) ShiroReportSys(m, 0);  // (the parent's tms_cstime)
   switch (nr) {
     case 0x063: {                                                     // sysinfo
