+////////////////////////////////////////////////////////////////////////////////
+// code on writable pages
+//
+// A JIT (HotSpot, V8, JavaScriptCore, LuaJIT) keeps its code in memory it
+// can write, so that code may change under a region compiled from it. A
+// writable page that code is compiled from is marked PAGE_WJC in its page
+// table entry. No write translation is cached for a marked page (WjFill
+// refuses, every thread's caches are dropped when the mark is set), so each
+// store to it reaches LookupAddressFor: a store in compiled code leaves its
+// region first and the interpreter runs it. LookupAddressFor calls WjWrote.
+//
+// - Each region remembers the 64-byte pieces of each marked page it was
+//   decoded from (its instructions and the ones the flag crawler read).
+//   A write that touches such a piece is logged; every thread drops the
+//   regions that depend on it before it next enters compiled code, and the
+//   writer leaves the regions it is in (m->attention).
+// - A write beside the code (data in the same page, a call site in code
+//   that isn't compiled yet) only costs the slow path. A page that takes
+//   kWjSlowMax of them inside kWjWindow ms (a write that hits code counts
+//   as kWjHitCost: a region to compile again) is given up: its regions are
+//   dropped, the mark is cleared and writes are fast again. It is taken
+//   again no sooner than kWjRest ms later, twice as long each time it is
+//   given up (at most kWjStrikes doublings; a page left alone for a
+//   minute starts over). So the worst a page of mixed code and data costs
+//   is a bounded number of slow writes per second, and otherwise it runs
+//   as it did before this patch: interpreted.
+// - When no compiled piece is left in a page its mark is cleared at the
+//   next write (a code buffer that is refilled).
+// - Only private anonymous pages of the process are taken. A page some
+//   system call holds locked (a read() into it under way) isn't taken now.
+//   A thread that writes without the GIL (inside a system call) drops the
+//   page's regions whatever it touches, and a region compiled meanwhile
+//   isn't entered. While a thread has let the GIL go in the middle of an
+//   instruction (a page fault's kernel call: it may hold an address it
+//   resolved before and write through it after), no writable page is
+//   compiled from. Without the GIL (BLINK_GIL=0) nothing here applies:
+//   writable pages stay with the interpreter.
+// - munmap and mprotect of a page with code drop everything, as before.
+//
+// What it costs code that never generates any: nothing on a store (the
+// test in LookupAddressFor shares the copy-on-write test's branch, WjFill
+// tests one more bit on a miss) and nothing on a region entry (the same
+// epoch compare).
+
+#define kWjGran    64
+#define kWjSlowMax 2048
+#define kWjHitCost 64
+#define kWjWindow  1000
+#define kWjRest    500
+#define kWjStrikes 6
+#define kWjLog     512
+
+struct WjPage {
+  i64 key;           // the page | 1 (0: empty)
+  u64 mask;          // the pieces some region was compiled from
+  unsigned full;     // g_wj_full when mask was set
+  unsigned nslow;    // slow writes in the window that began at `since`
+  unsigned strikes;  // times it was given up lately
+  double since;
+  double until;      // not taken again before this time
+  double gave;       // when it was last given up
+};
+
+static pthread_mutex_t g_wjp_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct WjPage *g_wjp;
+static unsigned g_wjp_cap, g_wjp_n;
+static struct WjDep g_wj_log[kWjLog];
+static unsigned g_wj_logn;  // entries ever logged
+// [0] pages marked, [1] writes that hit compiled code, [2] writes beside
+// it, [3] pages given up, [4] regions dropped, [5] regions compiled from
+// writable pages, [6] compiles put off, [7] marks cleared (no code left)
+long g_wj_smc[8];
+static _Atomic(int) g_wj_mid;  // threads without the GIL in the middle of an instruction
+
+void WjMidInstruction(int d) {
+  atomic_fetch_add_explicit(&g_wj_mid, d, memory_order_acq_rel);
+}
+
+// a region that depends on marked pages: its entries, and a node per page
+struct WjReg {
+  int n;    // 0: dropped
+  int *fn;  // table index of pc[i]'s entry (-1: a failed compile to forget)
+  i64 *pc;
+};
+struct WjNode {
+  i64 page;
+  u64 mask;
+  int reg;
+  int next;  // index + 1 of the next node in the bucket, 0: none
+};
+static _Thread_local struct WjReg *t_reg;
+static _Thread_local int t_nreg, t_creg;
+static _Thread_local struct WjNode *t_node;
+static _Thread_local int t_nnode, t_cnode, t_nodefree;
+static _Thread_local int t_bucket[1024];
+static _Thread_local unsigned t_full, t_logn;
+
+static u64 WjGranMask(int off, int len) {
+  int lo = off / kWjGran, hi = (off + len - 1) / kWjGran;
+  if (hi > 63) hi = 63;
+  return hi - lo == 63 ? -1ull : ((1ull << (hi - lo + 1)) - 1) << lo;
+}
+
+// (g_wjp_lock held)
+static struct WjPage *WjPageRec(i64 page, bool create) {
+  unsigned i, j, full;
+  struct WjPage *old, *r;
+  if (create && (g_wjp_n + 1) * 2 > g_wjp_cap) {
+    unsigned cap = g_wjp_cap ? g_wjp_cap * 2 : 256;
+    if (!(r = (struct WjPage *)calloc(cap, sizeof(*r)))) return 0;
+    old = g_wjp;
+    for (j = 0; j < g_wjp_cap; ++j) {
+      if (!old[j].key) continue;
+      for (i = Hash(old[j].key) & (cap - 1); r[i].key; i = (i + 1) & (cap - 1)) {
+      }
+      r[i] = old[j];
+    }
+    free(old);
+    g_wjp = r;
+    g_wjp_cap = cap;
+  }
+  if (!g_wjp_cap) return 0;
+  for (i = Hash(page | 1) & (g_wjp_cap - 1);; i = (i + 1) & (g_wjp_cap - 1)) {
+    if (g_wjp[i].key == (page | 1)) break;
+    if (!g_wjp[i].key) {
+      if (!create) return 0;
+      g_wjp[i].key = page | 1;
+      ++g_wjp_n;
+      break;
+    }
+  }
+  r = g_wjp + i;
+  full = atomic_load_explicit(&g_wj_full, memory_order_acquire);
+  if (r->full != full) {  // everything was dropped since
+    r->mask = 0;
+    r->full = full;
+  }
+  return r;
+}
+
+static void WjMarked(struct Machine *m, i64 page) {
+  struct Dll *e;
+  struct Machine *o;
+  struct WjTlb *t = m->wjw + ((page >> 12) & g_wj_tlb_mask);
+  if (t->tag == page) t->tag = -1;
+  LOCK(&m->system->machines_lock);
+  for (e = dll_first(m->system->machines); e; e = dll_next(m->system->machines, e)) {
+    if ((o = MACHINE_CONTAINER(e)) != m) {
+      atomic_store_explicit(&o->invalidated, true, memory_order_release);
+    }
+  }
+  UNLOCK(&m->system->machines_lock);
+}
+
+// CodePage() for a writable page: true if code may be compiled from it,
+// with its writes watched from now on
+static bool WjCodeWritable(struct Machine *m, i64 page, u64 entry) {
+  int i;
+  bool ok;
+  struct WjPage *r;
+  if (g_wj_rwx <= 0 || !g_gil_enabled) return false;
+  // a private anonymous page of this process alone: nothing else (another
+  // mapping of a shared object, a forked child, a file's cache) writes it
+  if ((entry & (PAGE_HOST | PAGE_MAP | PAGE_MUG | PAGE_RSRV | PAGE_REMOTE |
+                PAGE_SHRD | PAGE_GROW | PAGE_NOMW)) != PAGE_HOST) {
+    return false;
+  }
+  for (i = 0; i < t_ncd; ++i) {
+    if (t_cd[i].page == page) return true;
+  }
+  if (t_ncd == kWjMaxDeps) return false;  // (the region ends here)
+  if (atomic_load_explicit(&g_wj_mid, memory_order_acquire)) {
+    t_csoft = true;
+    ++g_wj_smc[6];
+    return false;
+  }
+  pthread_mutex_lock(&g_wjp_lock);
+  if (!(r = WjPageRec(page, true))) {
+    ok = false;
+  } else if (r->until && emscripten_get_now() < r->until) {
+    ok = false;  // given up a moment ago
+    t_csoft = true;
+  } else {
+    r->until = 0;
+    ok = true;
+  }
+  pthread_mutex_unlock(&g_wjp_lock);
+  if (ok) {
+    // a system call that is filling the page has its address already and
+    // holds the page locked (marked or not): not now
+    switch (ShiroPteBits(m, page, PAGE_WJC, 0, PAGE_LOCKS | PAGE_COW)) {
+      case 1:
+        // no write goes around the mark: the other threads drop their
+        // cached translations at their next lookup or region entry (none
+        // is inside a region with the GIL let go: g_wj_mid above), and
+        // this one drops its own for the page (ShiroPteBits did the
+        // interpreter's)
+        WjMarked(m, page);
+        ++g_wj_smc[0];
+        if (g_wj_debug > 1) fprintf(stderr, "wjit: writable page %#llx marked\n", (long long)page);
+        break;
+      case 0:
+        ok = false;
+        t_csoft = true;
+        break;
+      default:
+        break;
+    }
+  }
+  if (!ok) {
+    ++g_wj_smc[6];
+    return false;
+  }
+  t_cd[t_ncd].page = page;
+  t_cd[t_ncd].mask = 0;
+  ++t_ncd;
+  return true;
+}
+
+// the region being compiled depends on the `len` code bytes at `pc`
+static void WjDepNote(i64 pc, int len) {
+  int i;
+  i64 a, e, end, page;
+  if (!t_ncd) return;
+  for (a = pc, e = pc + len; a < e; a = end) {
+    page = a & -4096;
+    end = page + 4096 < e ? page + 4096 : e;
+    for (i = 0; i < t_ncd; ++i) {
+      if (t_cd[i].page == page) {
+        t_cd[i].mask |= WjGranMask(a & 4095, end - a);
+        break;
+      }
+    }
+  }
+}
+
+static void WjRegClear(void) {
+  int i;
+  for (i = 0; i < t_nreg; ++i) {
+    free(t_reg[i].fn);
+    free(t_reg[i].pc);
+  }
+  free(t_reg);
+  free(t_node);
+  t_reg = 0;
+  t_node = 0;
+  t_nreg = t_creg = t_nnode = t_cnode = t_nodefree = 0;
+  memset(t_bucket, 0, sizeof(t_bucket));
+}
+
+// records the region just compiled (entries fns[i] at pcs[i]) with the
+// marked pages it depends on (t_cd)
+static void WjRegister(const i64 *pcs, const int *fns, int n) {
+  int i, k, r, *b;
+  void *p;
+  struct WjPage *pg;
+  struct WjReg *g;
+  for (i = k = 0; i < t_ncd; ++i) k += !!t_cd[i].mask;
+  if (!k) return;
+  if (t_nreg == t_creg) {
+    if (!(p = realloc(t_reg, (t_creg ? t_creg * 2 : 64) * sizeof(*t_reg)))) return;
+    t_reg = (struct WjReg *)p;
+    t_creg = t_creg ? t_creg * 2 : 64;
+  }
+  r = t_nreg++;
+  g = t_reg + r;
+  g->n = n;
+  g->fn = (int *)malloc(n * sizeof(int));
+  g->pc = (i64 *)malloc(n * sizeof(i64));
+  memcpy(g->fn, fns, n * sizeof(int));
+  memcpy(g->pc, pcs, n * sizeof(i64));
+  for (i = 0; i < t_ncd; ++i) {
+    if (!t_cd[i].mask) continue;
+    if (t_nodefree) {
+      k = t_nodefree;
+      t_nodefree = t_node[k - 1].next;
+    } else {
+      if (t_nnode == t_cnode) {
+        p = realloc(t_node, (t_cnode ? t_cnode * 2 : 256) * sizeof(*t_node));
+        t_node = (struct WjNode *)p;
+        t_cnode = t_cnode ? t_cnode * 2 : 256;
+      }
+      k = ++t_nnode;
+    }
+    b = &t_bucket[Hash(t_cd[i].page) & 1023];
+    t_node[k - 1].page = t_cd[i].page;
+    t_node[k - 1].mask = t_cd[i].mask;
+    t_node[k - 1].reg = r;
+    t_node[k - 1].next = *b;
+    *b = k;
+  }
+  pthread_mutex_lock(&g_wjp_lock);
+  for (i = 0; i < t_ncd; ++i) {
+    if (t_cd[i].mask && (pg = WjPageRec(t_cd[i].page, true))) pg->mask |= t_cd[i].mask;
+  }
+  pthread_mutex_unlock(&g_wjp_lock);
+  if (fns[0] > 0) ++g_wj_smc[5];
+}
+
+static void WjKill(int r) {
+  int i, n = 0;
+  struct WjEnt *e;
+  struct WjReg *g = t_reg + r;
+  for (i = 0; i < g->n; ++i) {
+    if ((e = Find(g->pc[i])) && e->fn == g->fn[i]) {
+      e->fn = 0;  // counts again from the start
+      e->count = 1;
+    }
+    if (g->fn[i] > 0) g->fn[n++] = g->fn[i];
+  }
+  if (n) {
+    wj_release(g->fn, n);
+    ++g_wj_smc[4];
+  }
+  free(g->fn);
+  free(g->pc);
+  g->fn = 0;
+  g->pc = 0;
+  g->n = 0;
+}
+
+// this thread's regions that depend on those pieces of `page` go
+static void WjDropPage(i64 page, u64 mask) {
+  int k, *link = &t_bucket[Hash(page) & 1023];
+  struct WjNode *nd;
+  while ((k = *link)) {
+    nd = t_node + k - 1;
+    if (t_reg[nd->reg].n && nd->page == page && (nd->mask & mask)) WjKill(nd->reg);
+    if (!t_reg[nd->reg].n) {  // (a dropped region's nodes go as they're met)
+      *link = nd->next;
+      nd->next = t_nodefree;
+      t_nodefree = k;
+    } else {
+      link = &nd->next;
+    }
+  }
+}
+
+// g_wj_epoch moved (or the thread is new): everything goes, or what the
+// write log says. Only called with none of this thread's regions running.
+static void WjSync(void) {
+  unsigned i, n, full;
+  bool all;
+  struct WjDep *buf = 0;
+  full = atomic_load_explicit(&g_wj_full, memory_order_acquire);
+  pthread_mutex_lock(&g_wjp_lock);
+  n = g_wj_logn - t_logn;
+  all = !t_ready || t_full != full || n > kWjLog ||
+        (n && !(buf = (struct WjDep *)malloc(n * sizeof(*buf))));
+  if (!all) {
+    for (i = 0; i < n; ++i) buf[i] = g_wj_log[(t_logn + i) % kWjLog];
+  }
+  t_logn = g_wj_logn;
+  pthread_mutex_unlock(&g_wjp_lock);
+  t_full = full;
+  if (all) {
+    Clear();
+  } else {
+    for (i = 0; i < n; ++i) WjDropPage(buf[i].page, buf[i].mask);
+  }
+  free(buf);
+}
+
+void WjWrote(struct Machine *m, i64 virt, int len) {
+  i64 page = virt & -4096;
+  u64 mask;
+  bool drop = false, clear = false, mine;
+  struct WjPage *r;
+  if (g_wj_rwx >= 3) return;  // (the tests' missing invalidation)
+  // a thread inside a system call writes while another may be compiling
+  // from the page: whatever it touches, the page's regions go
+  mine = !g_gil_enabled || GilHeld();
+  mask = len < 0 || !mine ? -1ull : WjGranMask(virt & 4095, len ? len : 1);
+  pthread_mutex_lock(&g_wjp_lock);
+  r = WjPageRec(page, false);
+  if (!mine || (r && (r->mask & mask))) {
+    g_wj_log[g_wj_logn++ % kWjLog].page = page;
+    g_wj_log[(g_wj_logn - 1) % kWjLog].mask = mask;
+    atomic_fetch_add_explicit(&g_wj_epoch, 1, memory_order_release);
+    drop = true;
+    ++g_wj_smc[1];
