 blink/memory.c  |  83 +++++++-
 blink/modrm.c   |  14 +-
 blink/modrm.h   |   1 +
 blink/shiro.inc |   9 +-
 blink/ssemov.c  |   2 +-
 blink/string.c  |   4 +-
 blink/syscall.c |   2 +
 blink/wjit.c    | 530 +++++++++++++++++++++++++++++++++++++++++++++++-
 blink/wjit.h    |  10 +
 11 files changed, 635 insertions(+), 30 deletions(-)

diff --git a/blink/iovs.c b/blink/iovs.c
index 0000000..0000000 100644
--- a/blink/iovs.c
+++ b/blink/iovs.c
@@ -104,7 +104,7 @@ int AppendIovsReal(struct Machine *m, struct Iovs *ib, i64 addr, u64 size,
     need |= PAGE_RW;
   }
   while (size && ib->i < GetIovMax()) {
-    if (!(real = LookupAddress2(m, addr, mask, need))) return efault();
+    if (!(real = LookupAddressFor(m, addr, mask, need, (prot & PROT_WRITE) ? -1 : 0))) return efault();
     have = 4096 - (addr & 4095);
     got = MIN(size, have);
     if (AppendIovs(ib, real, got) == -1) return -1;
diff --git a/blink/machine.h b/blink/machine.h
index 0000000..0000000 100644
--- a/blink/machine.h
+++ b/blink/machine.h
@@ -111,6 +111,10 @@
 // writable (a write gets this process its own copy)
 #define PAGE_COW   0x0002000000000000
 #define PAGE_COWRW 0x0004000000000000
+// Shiro: the wasm JIT has compiled code from this writable page (wjit.c,
+// "code on writable pages"). No write translation is cached for it: each
+// write comes through LookupAddressFor, which reports it first (WjWrote)
+#define PAGE_WJC   0x0008000000000000
 // Shiro: a page of an object shared with other Blink instances (shmobj,
 // docs/research/SHARED_MAPPINGS.md): its bytes live in the kernel's
 // SharedArrayBuffer; the host page is this instance's shadow of them,
@@ -608,6 +612,10 @@ bool HasPageLock(const struct Machine *, i64) nosideeffect;
 void CollectPageLocks(struct Machine *);
 u8 *LookupAddress(struct Machine *, i64);
 u8 *LookupAddress2(struct Machine *, i64, u64, u64);
+u8 *LookupAddressFor(struct Machine *, i64, u64, u64, int);
+u8 *LookupAddressRead(struct Machine *, i64);
+u8 *ResolveAddressRead(struct Machine *, i64);
+int ShiroPteBits(struct Machine *, i64, u64, u64, u64);
 u8 *SpyAddress(struct Machine *, i64);
 u8 *Load(struct Machine *, i64, size_t, u8 *);
 u8 *MallocPage(void);
diff --git a/blink/memory.c b/blink/memory.c
index 0000000..0000000 100644
--- a/blink/memory.c
+++ b/blink/memory.c
@@ -334,7 +334,36 @@ u64 BreakCow(struct Machine *m, i64 virt) {
   return e2;
 }
 
+// Sets and clears bits in the entry of the 4 KiB page at `page`, unless the
+// entry (as it is now, not a cached copy) has one of `unless` (a system
+// call's page lock, say): 0 then, or when the page isn't mapped; 1 if the
+// entry changed, 2 if it had them already. This thread's cached copy follows.
+int ShiroPteBits(struct Machine *m, i64 page, u64 set, u64 clear, u64 unless) {
+  u8 *pslot;
+  u64 entry, e2;
+  long tlbkey = (page >> 12) & g_tlb_mask;
+  if (!(pslot = FindPteSlot(m, page))) return 0;
+  do {
+    entry = LoadPte(pslot);
+    if (!(entry & PAGE_V) || (entry & unless)) return 0;
+    e2 = (entry | set) & ~clear;
+  } while (e2 != entry && !CasPte(pslot, entry, e2));
+  if (m->tlb[tlbkey].page == (i64)(page | m->tlbgen)) {
+    m->tlb[tlbkey].entry = (m->tlb[tlbkey].entry | set) & ~clear;
+  }
+  return e2 != entry ? 1 : 2;
+}
+
 u8 *LookupAddress2(struct Machine *m, i64 virt, u64 mask, u64 need) {
+  // (an instruction fetch writes nothing; any other caller may)
+  return LookupAddressFor(m, virt, mask, need, mask == PAGE_XD && !need ? 0 : -1);
+}
+
+// LookupAddress2 with what the caller will do through the pointer: wlen 0,
+// only read; n > 0, write at most n bytes from `virt` on; -1, unknown (it
+// may write anywhere in the page). The wasm JIT's code from a writable
+// page (PAGE_WJC) is dropped by a write that touches it.
+u8 *LookupAddressFor(struct Machine *m, i64 virt, u64 mask, u64 need, int wlen) {
   u8 *host;
   u64 entry;
   if (!m->metal || m->mode.omode == XED_MODE_LONG ||
@@ -354,9 +383,14 @@ u8 *LookupAddress2(struct Machine *m, i64 virt, u64 mask, u64 need) {
   // soon as Blink resolves an address in it: many of its paths write
   // through a resolved pointer without checking PAGE_RW (only compiled
   // code's inline reads keep sharing; its writes come here)
-  if ((entry & PAGE_COW) && !(entry = BreakCow(m, virt))) {
-    m->segvcode = SEGV_MAPERR_LINUX;
-    return (u8 *)enomem();
+  if (UNLIKELY(entry & (PAGE_COW | PAGE_WJC))) {
+    if ((entry & PAGE_COW) && !(entry = BreakCow(m, virt))) {
+      m->segvcode = SEGV_MAPERR_LINUX;
+      return (u8 *)enomem();
+    }
+    if ((entry & PAGE_WJC) && wlen && (entry & mask) == need) {
+      WjWrote(m, virt, wlen);
+    }
   }
   if ((entry & mask) != need) {
     m->segvcode = SEGV_ACCERR_LINUX;
@@ -400,6 +434,19 @@ u8 *LookupAddress(struct Machine *m, i64 virt) {
   return LookupAddress2(m, virt, need, need);
 }
 
+// LookupAddress for a pointer that is only read through
+u8 *LookupAddressRead(struct Machine *m, i64 virt) {
+  u64 need = 0;
+  if (Cpl(m) == 3) need = PAGE_U;
+  return LookupAddressFor(m, virt, need, need, 0);
+}
+
+u8 *ResolveAddressRead(struct Machine *m, i64 v) {
+  u8 *r;
+  if ((r = LookupAddressRead(m, v))) return r;
+  ThrowSegmentationFault(m, v);
+}
+
 flattencalls u8 *GetAddress(struct Machine *m, i64 v) {
   if (HasLinearMapping()) return ToHost(v);
   return LookupAddress(m, v);
@@ -481,7 +528,7 @@ int VirtualCopy(struct Machine *m, i64 v, char *r, u64 n, bool d) {
       k = 4096;
       continue;
     }
-    if (!(p = d ? LookupAddress(m, v) : LookupAddressWrite(m, v))) return -1;
+    if (!(p = d ? LookupAddressRead(m, v) : LookupAddressWrite(m, v))) return -1;
     if (d) {
       memcpy(r, p, k);
     } else if (!IsRomAddress(m, p)) {
@@ -562,7 +609,7 @@ u8 *ReserveAddress(struct Machine *m, i64 v, size_t n, bool writable) {
     need = 0;
   }
   if ((v & 4095) + n <= 4096) {
-    if ((res = LookupAddress2(m, v, mask, need))) {
+    if ((res = LookupAddressFor(m, v, mask, need, writable ? (n ? (int)n : 1) : 0))) {
       if (!IsRomAddress(m, res)) return res;
       p1 = res;
       m->stashaddr = v;
@@ -584,8 +631,8 @@ u8 *ReserveAddress(struct Machine *m, i64 v, size_t n, bool writable) {
   m->opcache->writable = writable;
   res = m->opcache->stash;
   k = 4096 - (v & 4095);
-  if ((p1 = LookupAddress2(m, v, mask, need))) {
-    if ((p2 = LookupAddress2(m, v + k, mask, need))) {
+  if ((p1 = LookupAddressFor(m, v, mask, need, writable ? (int)k : 0))) {
+    if ((p2 = LookupAddressFor(m, v + k, mask, need, writable ? (int)(n - k) : 0))) {
       IGNORE_RACES_START();
       memcpy(res, p1, k);
       memcpy(res + k, p2, n - k);
@@ -604,6 +651,19 @@ static u8 *AccessRam2(struct Machine *m, i64 v, size_t n, void *p[2], u8 *tmp,
   u8 *a, *b;
   unsigned k;
   unassert(n <= 4096);
+  if (copy && !protect_rom) {  // Load(), a pop: read only
+    if ((v & 4095) + n <= 4096) return ResolveAddressRead(m, v);
+    STATISTIC(++page_overlaps);
+    k = 4096;
+    k -= v & 4095;
+    a = ResolveAddressRead(m, v);
+    b = ResolveAddressRead(m, v + k);
+    memcpy(tmp, a, k);
+    memcpy(tmp + k, b, n - k);
+    p[0] = a;
+    p[1] = b;
+    return tmp;
+  }
   if ((v & 4095) + n <= 4096) {
     a = ResolveAddress(m, v);
     if (!protect_rom || !IsRomAddress(m, a)) return a;
@@ -703,7 +763,8 @@ void *Schlep(struct Machine *m, i64 addr, size_t size, u64 mask, u64 need) {
   size_t have;
   void *res, *page;
   if (!size) return 0;
-  if (!(page = LookupAddress2(m, addr, mask, need))) return 0;
+  int w = (need & PAGE_RW) ? -1 : 0;  // SchlepR only reads
+  if (!(page = LookupAddressFor(m, addr, mask, need, w))) return 0;
   have = 4096 - (addr & 4095);
   if (size <= have) {
     res = page;
@@ -711,7 +772,7 @@ void *Schlep(struct Machine *m, i64 addr, size_t size, u64 mask, u64 need) {
     if (!(copy = (char *)malloc(size))) return 0;
     memcpy(copy, page, have);
     for (; have < size; have += 4096) {
-      if (!(page = LookupAddress2(m, addr + have, mask, need))) {
+      if (!(page = LookupAddressFor(m, addr + have, mask, need, w))) {
         free(copy);
         return 0;
       }
@@ -746,7 +807,7 @@ char *LoadStr(struct Machine *m, i64 addr) {
   char *copy, *page, *p;
   have = 4096 - (addr & 4095);
   if (!addr) return 0;
-  if (!(page = (char *)LookupAddress2(m, addr, PAGE_U, PAGE_U))) return 0;
+  if (!(page = (char *)LookupAddressFor(m, addr, PAGE_U, PAGE_U, 0))) return 0;
   if ((p = (char *)memchr(page, '\0', have))) {
     SetReadAddr(m, addr, p - page + 1);
     return page;
@@ -754,7 +815,7 @@ char *LoadStr(struct Machine *m, i64 addr) {
   if (!(copy = (char *)malloc(have + 4096))) return 0;
   memcpy(copy, page, have);
   for (;;) {
-    if (!(page = (char *)LookupAddress2(m, addr + have, PAGE_U, PAGE_U))) break;
+    if (!(page = (char *)LookupAddressFor(m, addr + have, PAGE_U, PAGE_U, 0))) break;
     if ((p = (char *)memccpy(copy + have, page, '\0', 4096))) {
       SetReadAddr(m, addr, have + (p - (copy + have)) + 1);
       return (char *)AddToFreeList(m, copy);
diff --git a/blink/modrm.c b/blink/modrm.c
index 0000000..0000000 100644
--- a/blink/modrm.c
+++ b/blink/modrm.c
@@ -293,27 +293,33 @@ u8 *GetModrmRegisterXmmPointerWrite16(P) {
   return GetModrmRegisterXmmPointerWrite(A, 16);
 }
 
-static u8 *GetVectorAddress(P, size_t n) {
+static u8 *GetVectorAddress(P, size_t n, bool write) {
   u8 *p;
   i64 v;
+  u64 need = Cpl(m) == 3 ? PAGE_U : 0;
   if (IsModrmRegister(rde)) {
     p = XmmRexbRm(m, rde);
   } else {
     v = ComputeAddress(A);
     SetReadAddr(m, v, n);
-    if ((v & (n - 1)) || !(p = LookupAddress(m, v))) {
+    if ((v & (n - 1)) || !(p = LookupAddressFor(m, v, need, need, write ? (int)n : 0))) {
       ThrowSegmentationFault(m, v);
     }
   }
   return p;
 }
 
+// (the aligned operand as a destination: movdqa/movaps to memory)
+u8 *GetXmmAddressWrite(P) {
+  return GetVectorAddress(A, 16, true);
+}
+
 u8 *GetMmxAddress(P) {
-  return GetVectorAddress(A, 8);
+  return GetVectorAddress(A, 8, false);
 }
 
 u8 *GetXmmAddress(P) {
-  return GetVectorAddress(A, 16);
+  return GetVectorAddress(A, 16, false);
 }
 
 u8 *GetModrmReadBW(P) {
