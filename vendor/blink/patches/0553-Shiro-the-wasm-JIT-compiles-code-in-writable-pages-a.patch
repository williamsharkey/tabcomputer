diff --git a/blink/syscall.c b/blink/syscall.c
index 0000000..0000000 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -83,6 +83,7 @@
 #include "blink/timespec.h"
 #include "blink/util.h"
 #include "blink/vfs.h"
+#include "blink/wjit.h"
 #include "blink/xlat.h"
 
 #ifdef __linux
@@ -1531,6 +1532,7 @@ static int SysMadvise(struct Machine *m, i64 addr, u64 len, int advice) {
       if ((e & PAGE_COWRW) && !(e = BreakCow(m, p))) continue;  // (zeros here only)
       if ((e & (PAGE_V | PAGE_U | PAGE_RW)) != (PAGE_V | PAGE_U | PAGE_RW)) continue;
       if (e & (PAGE_RSRV | PAGE_FILE | PAGE_MAP)) continue;  // untouched, or file
+      if (e & PAGE_WJC) WjWrote(m, p, -1);  // (compiled code from the page goes)
       if ((h = GetPageAddress(m->system, e, false))) memset(h, 0, 4096);
     }
     UNLOCK(&m->system->mmap_lock);
diff --git a/blink/wjit.c b/blink/wjit.c
index 0000000..0000000 100644
--- a/blink/wjit.c
+++ b/blink/wjit.c
@@ -66,9 +66,10 @@
  * - Jumps inside a region spend a budget and check m->attention, so the
  *   GIL, signals and other threads still get a turn.
  * - Wasm tables aren't shared between pthreads, so each thread compiles
- *   and keeps its own regions. Code is only compiled from pages that are
- *   not writable; when such a page is unmapped or its protection changes,
- *   a global epoch makes every thread drop its regions.
+ *   and keeps its own regions. When a page that held code is unmapped or
+ *   its protection changes, a global epoch makes every thread drop its
+ *   regions. Code in a writable page (a JIT's code cache) is compiled too:
+ *   see "code on writable pages" below.
  *
  * BLINK_WJIT=0 turns it off. BLINK_WJIT_THRESHOLD sets the hotness,
  * BLINK_WJIT_DEBUG=1 prints statistics; BLINK_WJIT_OFF, _MAX and _BISECT
@@ -96,6 +97,27 @@ static int g_wj_maxblk = 64;  // BLINK_WJIT_BLOCKS (at most kMaxBlocks)
 static bool g_wj_straddle;
 static i64 g_wj_lo = -1, g_wj_hi = -1;  // BLINK_WJIT_BISECT=lo:hi (pc range; 64-bit: guest code is above 2 GiB)
 static _Atomic(unsigned) g_wj_epoch;
+// g_wj_epoch moves on every change compiled code must see; g_wj_full says
+// how many of them drop everything (the others are in the write log)
+static _Atomic(unsigned) g_wj_full;
+// BLINK_WJIT_RWX: 1 (the default) compiles code in writable pages, 0 leaves
+// it to the interpreter. For the tests, what a missing invalidation does:
+// 3 compiles it and ignores the writes, 4 ignores mprotect and munmap too
+static int g_wj_rwx = 1;
+static bool WjCodeWritable(struct Machine *, i64, u64);
+static void WjDepNote(i64, int);
+static void WjSync(void);
+static void WjRegister(const i64 *, const int *, int);
+static void WjRegClear(void);
+// the write-watched pages the region being compiled was decoded from, and
+// which 64-byte pieces of each
+#define kWjMaxDeps 12
+static _Thread_local struct WjDep {
+  i64 page;
+  u64 mask;
+} t_cd[kWjMaxDeps];
+static _Thread_local int t_ncd;
+static _Thread_local bool t_csoft;  // the compile failed for now: try again later
 
 // statistics
 static long g_wj_callops[0x400];
@@ -239,6 +261,17 @@ double WjStat(int which) {
   return wj_stat(which);
 }
 
+// gives back the table slots of one region (its code was overwritten)
+EM_JS(void, wj_release, (const int *p, int n), {
+  p >>>= 0;
+  var free = Module['wjFree'] || (Module['wjFree'] = []);
+  for (var i = 0; i < n; i++) {
+    var idx = HEAP32[(p >>> 2) + i];
+    wasmTable.set(idx, null);
+    free.push(idx);
+  }
+});
+
 // drops every function this worker installed (new thread, or an epoch flip)
 EM_JS(void, wj_release_all, (void), {
   var all = Module['wjAll'] || [];
@@ -549,14 +582,16 @@ static void WjFill(struct Machine *m, i64 v, bool write) {
   struct WjTlb *t;
   if (!(entry = FindPageTableEntry(m, v & -4096))) return;
   if (!(entry & PAGE_U) || (entry & PAGE_REMOTE)) return;
-  if (write && !(entry & PAGE_RW)) return;
+  // (no write translation for a page that holds compiled code: the store
+  // leaves the region and the interpreter's lookup reports it, WjWrote)
+  if (write && (entry & (PAGE_RW | PAGE_WJC)) != PAGE_RW) return;
   if (!(host = GetPageAddress(m->system, entry, false))) return;
   if (IsRomAddress(m, host)) return;
   t = write ? m->wjw : m->wjr;
