From dd38b96502912f3c124a080816a60b89c68e8f25 Mon Sep 17 00:00:00 2001
From: shiro <build@shiro>
Date: Tue, 13 Oct 2026 08:18:08 -0400
Subject: [PATCH] Shiro: fxsave and fxrstor keep the x87 tags (ld.so's left
 four registers "in use": numpy's invalid-value warnings); x87 exception flags

fxsave's tag byte has one bit a register. Blink saved the low byte of its
two-bit tags there, and fxrstor loaded that byte back as the whole tag
word: empty registers 4 to 7 came back marked in use. ld.so runs both
around the first call of each library function (_dl_runtime_resolve), so in
any dynamically linked program the next x87 code whose push landed on one
of those registers got a stack overflow: IE, SF and C1 set in the status
word. The values were right, the flags were not. gcc's inline fmod is such
code (fld, fld, fprem), and so is libm's long double code; numpy reads the
flags after each loop and warned "invalid value encountered in remainder"
(and in cast, multiply, reduce, exp2 and log10 for long double: #110 item
6).

Also, from comparing the status word after single instructions with
Rosetta:
- fucom, fucomp, fucompp, fucomi and fucomip raised IE for a quiet NaN.
  Only fcom and its kind do.
- fprem and fprem1 set C0, C3 and C1 from the two's complement of a
  negative quotient, not from its magnitude (-40.25 mod 17: C0 was set).
- fist, fistp and fisttp of a value that doesn't fit now also set IE.
---
 blink/fpu.c     | 61 ++++++++++++++++++++++++++++++++-----------------
 blink/machine.c | 29 +++++++++++++++++++++--
 2 files changed, 67 insertions(+), 23 deletions(-)

diff --git a/blink/fpu.c b/blink/fpu.c
index 0000000..0000000 100644
--- a/blink/fpu.c
+++ b/blink/fpu.c
@@ -197,6 +197,7 @@ static double x87remainder(double x, double y, u32 *sw,
   s = 0;
   r = rem(x, y);
   q = rnd(x / y);
+  if (q < 0) q = -q;  // (C0, C3 and C1 are the low bits of the quotient's magnitude)
   s &= ~kFpuSwC2; /* ty libm */
   if (q & 1) s |= kFpuSwC1;
   if (q & 2) s |= kFpuSwC3;
@@ -266,17 +267,24 @@ static double FpuRound(struct Machine *m, double x) {
   }
 }
 
-static void FpuCompare(struct Machine *m, double y) {
+// fcom and its kind raise IE for any NaN; fucom and its kind only for a
+// signaling one, which a register that is a double doesn't keep apart
+static void FpuCompare2(struct Machine *m, double y, bool quiet) {
   double x = St0(m);
   m->fpu.sw &= ~(kFpuSwC0 | kFpuSwC1 | kFpuSwC2 | kFpuSwC3);
   if (!isunordered(x, y)) {
     if (x < y) m->fpu.sw |= kFpuSwC0;
     if (x == y) m->fpu.sw |= kFpuSwC3;
   } else {
-    m->fpu.sw |= kFpuSwC0 | kFpuSwC2 | kFpuSwC3 | kFpuSwIe;
+    m->fpu.sw |= kFpuSwC0 | kFpuSwC2 | kFpuSwC3;
+    if (!quiet) m->fpu.sw |= kFpuSwIe;
   }
 }
 
+static void FpuCompare(struct Machine *m, double y) {
+  FpuCompare2(m, y, false);
+}
+
 static void OpFxam(struct Machine *m) {
   double x;
   x = *FpuSt(m, 0);
@@ -775,40 +783,46 @@ static void OpFildll(struct Machine *m) {
 // What fist/fistp/fisttp store: the integer, or the "integer indefinite"
 // (the most negative value) for a NaN or a value that doesn't fit. (A C
 // cast saturated: 1e10 was stored as INT_MAX, and as -1 in 16 bits.)
-static i16 FpuInt16(double x) {
-  return x > -32769.0 && x < 32768.0 ? (i16)x : INT16_MIN;
+static i16 FpuInt16(struct Machine *m, double x) {
+  if (x > -32769.0 && x < 32768.0) return (i16)x;
+  m->fpu.sw |= kFpuSwIe;
+  return INT16_MIN;
 }
 
-static i32 FpuInt32(double x) {
-  return x > -2147483649.0 && x < 2147483648.0 ? (i32)x : INT32_MIN;
+static i32 FpuInt32(struct Machine *m, double x) {
+  if (x > -2147483649.0 && x < 2147483648.0) return (i32)x;
+  m->fpu.sw |= kFpuSwIe;
+  return INT32_MIN;
 }
 
-static i64 FpuInt64(double x) {
-  return x >= -9223372036854775808.0 && x < 9223372036854775808.0 ? (i64)x : INT64_MIN;
+static i64 FpuInt64(struct Machine *m, double x) {
+  if (x >= -9223372036854775808.0 && x < 9223372036854775808.0) return (i64)x;
+  m->fpu.sw |= kFpuSwIe;
+  return INT64_MIN;
 }
 
 static void OpFisttpl(struct Machine *m) {
-  FpuSetMemoryInt(m, FpuInt32(FpuPop(m)));
+  FpuSetMemoryInt(m, FpuInt32(m, FpuPop(m)));
 }
 
 static void OpFisttpll(struct Machine *m) {
-  FpuSetMemoryLong(m, FpuInt64(FpuPop(m)));
+  FpuSetMemoryLong(m, FpuInt64(m, FpuPop(m)));
 }
 
 static void OpFisttps(struct Machine *m) {
-  FpuSetMemoryShort(m, FpuInt16(FpuPop(m)));
+  FpuSetMemoryShort(m, FpuInt16(m, FpuPop(m)));
 }
 
 static void OpFists(struct Machine *m) {
-  FpuSetMemoryShort(m, FpuInt16(FpuRound(m, St0(m))));
+  FpuSetMemoryShort(m, FpuInt16(m, FpuRound(m, St0(m))));
 }
 
 static void OpFistl(struct Machine *m) {
-  FpuSetMemoryInt(m, FpuInt32(FpuRound(m, St0(m))));
+  FpuSetMemoryInt(m, FpuInt32(m, FpuRound(m, St0(m))));
 }
 
 static void OpFistll(struct Machine *m) {
-  FpuSetMemoryLong(m, FpuInt64(FpuRound(m, St0(m))));
+  FpuSetMemoryLong(m, FpuInt64(m, FpuRound(m, St0(m))));
 }
 
 static void OpFistpl(struct Machine *m) {
@@ -826,7 +840,7 @@ static void OpFistps(struct Machine *m) {
   FpuPop(m);
 }
 
-static void OpFcomi(struct Machine *m, u64 rde) {
+static void FpuComi(struct Machine *m, u64 rde, bool quiet) {
   double x, y;
   x = St0(m);
   y = StRm(m, rde);
@@ -835,25 +849,29 @@ static void OpFcomi(struct Machine *m, u64 rde) {
     m->flags = SetFlag(m->flags, FLAGS_CF, x < y);
     m->flags = SetFlag(m->flags, FLAGS_PF, false);
   } else {
-    m->fpu.sw |= kFpuSwIe;
+    if (!quiet) m->fpu.sw |= kFpuSwIe;  // (fucomi: not for a quiet NaN)
     m->flags = SetFlag(m->flags, FLAGS_ZF, true);
     m->flags = SetFlag(m->flags, FLAGS_CF, true);
     m->flags = SetFlag(m->flags, FLAGS_PF, true);
   }
 }
 
+static void OpFcomi(struct Machine *m, u64 rde) {
+  FpuComi(m, rde, false);
+}
+
 static void OpFucom(struct Machine *m, u64 rde) {
-  FpuCompare(m, StRm(m, rde));
+  FpuCompare2(m, StRm(m, rde), true);
 }
 
 static void OpFucomp(struct Machine *m, u64 rde) {
-  FpuCompare(m, StRm(m, rde));
+  FpuCompare2(m, StRm(m, rde), true);
   FpuPop(m);
 }
 
 static void OpFucompp(struct Machine *m, u64 rde) {
   if (ModrmRm(rde) != 1) OpUdImpl(m);  // (DA E9 is the only form)
-  FpuCompare(m, *FpuSt(m, 1));
+  FpuCompare2(m, *FpuSt(m, 1), true);
   FpuPop(m);
   FpuPop(m);
 }
@@ -864,11 +882,12 @@ static void OpFcomip(struct Machine *m, u64 rde) {
 }
 
 static void OpFucomi(struct Machine *m, u64 rde) {
-  OpFcomi(m, rde);
+  FpuComi(m, rde, true);
 }
 
 static void OpFucomip(struct Machine *m, u64 rde) {
-  OpFcomip(m, rde);
+  FpuComi(m, rde, true);
+  FpuPop(m);
 }
 
 static void OpFfree(struct Machine *m, u64 rde) {
diff --git a/blink/machine.c b/blink/machine.c
index 0000000..0000000 100644
--- a/blink/machine.c
+++ b/blink/machine.c
@@ -1264,6 +1264,31 @@ static void OpDoubleShift(P) {
                      Opcode(rde) & 1 ? m->cl : uimm0, Opcode(rde) & 8));
 }
 
+// fxsave's tag byte has one bit a register, set when the register is in
+// use; Blink keeps the x87's two-bit tags (3: empty). (The low byte of the
+// tags was saved and loaded back as the whole word, so after an fxsave and
+// fxrstor registers 4 to 7 counted as in use. ld.so does both around the
+// first call of each library function, and the next x87 code that pushed
+// onto one of them got a stack overflow: IE and SF set, which is where
+// numpy's "invalid value encountered" warnings came from.)
+static u8 FpuAbridgedTags(unsigned tw) {
+  int i;
+  u8 a = 0;
+  for (i = 0; i < 8; ++i) {
+    if (((tw >> (i * 2)) & 3) != 3) a |= 1 << i;
+  }
+  return a;
+}
+
+static unsigned FpuFullTags(u8 a) {
+  int i;
+  unsigned tw = 0;
+  for (i = 0; i < 8; ++i) {
+    if (!(a & (1 << i))) tw |= 3u << (i * 2);
+  }
+  return tw;
+}
+
 static void OpFxsave(P) {
   i64 v;
   u8 buf[32];
@@ -1271,7 +1296,7 @@ static void OpFxsave(P) {
   Write16(buf + 0, m->fpu.cw);
 #ifndef DISABLE_X87
   Write16(buf + 2, m->fpu.sw);
-  Write8(buf + 4, m->fpu.tw);
+  Write8(buf + 4, FpuAbridgedTags(m->fpu.tw));
   Write16(buf + 6, m->fpu.op);
   Write32(buf + 8, m->fpu.ip);
 #endif
@@ -1304,7 +1329,7 @@ static void OpFxrstor(P) {
   m->fpu.cw = Load16(buf + 0);
 #ifndef DISABLE_X87
   m->fpu.sw = Load16(buf + 2);
-  m->fpu.tw = Load8(buf + 4);
+  m->fpu.tw = FpuFullTags(Load8(buf + 4));
   m->fpu.op = Load16(buf + 6);
   m->fpu.ip = Load32(buf + 8);
 #endif
